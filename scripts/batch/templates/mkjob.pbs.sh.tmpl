#!/bin/bash
#PBS -S /bin/bash
#PBS -q {queue}
#PBS -l nodes={node_request}
#PBS -l walltime={walltime}
#PBS -N {name}
#PBS -m n

if [ "${{BASH_SOURCE[0]}}" != "$0" ]; then
    printf 'Execute this job script; do not source it.\n' >&2
    return 0
fi
trap 'job_status=$?; printf "finished %s exit=%s\n" "$(date -u +%FT%TZ)" "$job_status"; exit "$job_status"' EXIT
printf 'started %s\n' "$(date -u +%FT%TZ)"
. "$HOME/.bashrc"
cd -- {directory}
{initialization}
job_command=({command})
"${{job_command[@]}}"
