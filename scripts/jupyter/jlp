#!/usr/bin/env bash

# Require exactly one numeric TCP port argument.
if [ "$#" -ne 1 ]; then
    printf 'Usage: jlp PORT\n' >&2
    exit 2
fi
case "$1" in
    ''|*[!0-9]*) printf 'Usage: jlp PORT\n' >&2; exit 2 ;;
esac

# Interpret the port as decimal and validate its range.
if [ "${#1}" -gt 5 ]; then
    printf 'Port must be between 1 and 65535.\n' >&2
    exit 2
fi
port=$((10#$1))
if (( port < 1 || port > 65535 )); then
    printf 'Port must be between 1 and 65535.\n' >&2
    exit 2
fi

# Use Jupyter from the caller's active environment.
if ! command -v jupyter >/dev/null 2>&1; then
    printf 'jupyter was not found; activate the intended conda environment.\n' >&2
    exit 1
fi

# Prepare the log before launching so old URLs cannot be picked up.
log_file="$PWD/jupyter-$port.log"
: > "$log_file" || exit 1

# Keep Jupyter running independently of the SSH session.
nohup jupyter lab --ip=localhost --no-browser \
    --port="$port" --ServerApp.port_retries=0 \
    > "$log_file" 2>&1 < /dev/null &
server_pid=$!

# Wait up to 20 seconds for Jupyter to publish its connection URL.
for (( attempt=0; attempt<100; attempt++ )); do
    url="$(
        grep -Eo "http://(localhost|127[.]0[.]0[.]1):${port}/[^[:space:]]*" \
            "$log_file" | sed -n '1p'
    )"
    if [ -n "$url" ]; then
        printf '\n%s\n\nPID: %s\nLog: %s\n' \
            "$url" "$server_pid" "$log_file"
        exit 0
    fi

    # Stop waiting if the launched process has already exited.
    if ! kill -0 "$server_pid" 2>/dev/null; then
        wait "$server_pid"
        printf 'Jupyter exited before publishing its URL.\n' >&2
        tail -n 30 "$log_file" >&2
        exit 1
    fi
    sleep 0.2
done

# Leave a slow-starting server running and report where to check progress.
printf 'The URL was not found within 20 seconds.\nPID: %s\nLog: %s\n' \
    "$server_pid" "$log_file" >&2
tail -n 15 "$log_file" >&2
exit 1
